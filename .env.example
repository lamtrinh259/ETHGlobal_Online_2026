# --- chain ---
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=                # deployer / relayer EOA (never commit)
ETHERSCAN_V2_KEY=

# --- privy ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY_JWK= # {"kty":"EC","crv":"P-256","x":"...","y":"..."} from dashboard

# --- registrar (enclave secrets; here only for the Node fallback + CRE simulation) ---
SECRET_REGISTRAR_KEY=       # 0x-prefixed secp256k1 private key of the domain registrar
SECRET_VIEWCODE_KEY=        # 0x-prefixed 32-byte HMAC key

# --- cre ---
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=staging-settings
