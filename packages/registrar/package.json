{
  "name": "@ketsuban/registrar",
  "version": "0.1.0",
  "description": "Attestation registrar: (idToken, intent, sig, secrets) -> { record, signature, viewCode? }. Pure, WASM-safe; wrapped by the CRE enclave handler and the Node fallback.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@peeramid-labs/multipass-client": "1.1.0",
    "viem": "^2.38.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
