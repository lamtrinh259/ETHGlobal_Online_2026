{
  "name": "ketsuban",
  "private": true,
  "version": "0.1.0",
  "description": "Non-deletable, human-verified references on ENSv2 + Multipass, attested by a Chainlink CRE enclave",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "check:lockfile": "pnpm install --frozen-lockfile --lockfile-only"
  }
}
