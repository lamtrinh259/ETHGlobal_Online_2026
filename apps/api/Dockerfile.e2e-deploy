# The contracts, deployed into the e2e chain from an image rather than from a mount of the checkout.
#
# The stack used to bind-mount the repo and compile out of it. Compose paths are resolved by the
# daemon, so on a runner that executes the job inside a container that mount lands empty — the host has
# no such path — and the deploy service died in seconds with the contracts nowhere to be found.
#
# The sources alone are not enough: the contracts import `@peeramid-labs/multipass` and OpenZeppelin
# from `node_modules`, which under pnpm are symlinks into a store at the root of the workspace. `pnpm
# deploy` resolves them into one self-contained directory, which is what can travel in an image.
FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/registrar/package.json packages/registrar/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/cre/attest/package.json packages/cre/attest/
# Only what the contracts import; the rest of the workspace is a browser app and a relay.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @ketsuban/contracts
COPY packages/contracts/ packages/contracts/
# Dereferenced: pnpm links a dependency into the store, and a symlink copied into another image
# points at nothing. solc reads these as source, so they have to be real files.
RUN mkdir -p /contracts && cp -a packages/contracts/. /contracts/ \
    && rm -rf /contracts/node_modules \
    && cp -rL packages/contracts/node_modules /contracts/node_modules

FROM ghcr.io/foundry-rs/foundry:latest
USER root
WORKDIR /contracts
COPY --from=deps /contracts/ ./
# `lib/` is the forge-std submodule; a checkout without it fails here rather than mid-compile.
RUN test -f lib/forge-std/src/Test.sol || (echo "forge-std is not in this build context" && exit 1)
# Warm, so the run itself is the deploy rather than a first compile.
RUN forge build
