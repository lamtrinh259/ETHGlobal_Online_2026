# Paste into Coolify → project → Environment Variables (compose: apps/api/docker-compose.yml).
# Public values are filled for the current Sepolia deployment (packages/contracts/deployments/11155111.json).
# Secrets are placeholders — set them in Coolify as "secret" variables, never in git.

# --- chain ---
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
MULTIPASS=0x418F82fd0014a4CA402F145978bfaF0555a9cA06
FACTORY=0xc0281d75974155fE8513F623de726F040c4bcC51
BRIDGE=0xC7283bD9Aad1B08947C841536946Ce4dA9c99929

# --- relayer (pays for bridge.verify; Privy server wallet replaces this later) ---
RELAYER_KEY=0x<funded sepolia private key>

# --- privy ---
PRIVY_APP_ID=cmtr2o4p401xc0cjqur64l2m2
PRIVY_VERIFICATION_KEY_JWK={"kty":"EC","crv":"P-256","x":"fU9kCos_zHMfbvgZnjImcqGrScwAw39yHb4ojuwvZZo","y":"xMCQAgqXpH17uoLtzayIiu5E2VHJVIlCHKhVGMzql1w"}

# --- vouch instances (relay provisions ~<handle> under the root registry on first claim) ---
REGISTRY=0x254D9c7601BD8fa6b6FA7f5A42c860d184E053A7
PERMISSIONED_RESOLVER=0x4E2d9783cEFF2ed72CD77C14206b29fe246b24F7
REGISTRAR_ADDRESS=0x8583AD4a0F59Ba45C7E201318C6F774F31f7bbC8
DEPLOY_BLOCK=11660340

# --- instances served (comma-separated Multipass name domains) ---
NAME_DOMAINS=ketsuban,kju-is

# --- CRE delivery auth: same value goes in the workflow's delivery header ---
DELIVERY_TOKEN=<random ≥16 chars>

# --- browser origins allowed (web app domain); "*" = any ---
CORS_ORIGINS=https://ketsuban-app.peeramid.xyz

# --- record term (seconds) ---
RECORD_TERM_SECONDS=2592000

# --- Node registrar fallback (spec B.9.7). Leave EMPTY when the CRE enclave signs. ---
REGISTRAR_KEY=
VIEWCODE_KEY=

# Test-gas the relayer sends once to a wallet with a live name (wei; 0 = disabled). 0.002 ETH covers a few Sepolia txs.
GAS_TOPUP_WEI=2000000000000000

# In-process indexer: it tails Registered/Renewed/nameDeleted from DEPLOY_BLOCK and answers every
# record query from memory, so no request depends on a wide eth_getLogs succeeding.
# DATA_DIR must be a writable volume (docker-compose.yml mounts one) or the history is re-read on restart.
DATA_DIR=/data
INDEX_POLL_SECONDS=15
# Keep inside the provider's range cap; the reader halves the window on failure and grows it back.
RPC_LOG_WINDOW=10000

# ENSv2 UniversalResolver: enables GET /v1/ens/:name, the independent resolution path the web app
# cross-checks against. Sepolia: 0x4A1817d13E9cF196f471725176355C1234b63C70
UNIVERSAL_RESOLVER=0x4A1817d13E9cF196f471725176355C1234b63C70

# A statement in a vouch domain needs the candidate's signed invitation. Leave it on: without it
# anyone could write into a stranger's vouch domain. "false" disables the check.
# Anyone may refer anyone; a reference nobody asked for is marked unsolicited rather than refused.
# Set to true for a deployment that wants only invited references.
# Letters live under DATA_DIR and nothing gates writing one, so the store has a ceiling. Raise it if
# real letters start being refused; lower it if the volume is not yours to host.
LETTER_STORE_BYTES=26214400

REQUIRE_INVITE=false

# Operator secret for POST /v1/org, which onboards an organisation (a wallet that may issue references
# without an invitation). Leave unset to disable that endpoint entirely.
ORG_TOKEN=
