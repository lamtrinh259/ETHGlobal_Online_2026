# Paste into Coolify → project → Environment Variables (compose: apps/api/docker-compose.yml).
# Public values are filled for the current Sepolia deployment (packages/contracts/deployments/11155111.json).
# Secrets are placeholders — set them in Coolify as "secret" variables, never in git.

# --- chain ---
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
MULTIPASS=0x418F82fd0014a4CA402F145978bfaF0555a9cA06
FACTORY=0xc0281d75974155fE8513F623de726F040c4bcC51
BRIDGE=0xC7283bD9Aad1B08947C841536946Ce4dA9c99929

# --- relayer (pays for bridge.verify; Privy server wallet replaces this later) ---
RELAYER_KEY=0x<funded sepolia private key>

# --- privy ---
PRIVY_APP_ID=cmtr2o4p401xc0cjqur64l2m2
PRIVY_VERIFICATION_KEY_JWK={"kty":"EC","crv":"P-256","x":"fU9kCos_zHMfbvgZnjImcqGrScwAw39yHb4ojuwvZZo","y":"xMCQAgqXpH17uoLtzayIiu5E2VHJVIlCHKhVGMzql1w"}

# --- instances served (comma-separated Multipass name domains) ---
NAME_DOMAINS=ketsuban,kju-is

# --- CRE delivery auth: same value goes in the workflow's delivery header ---
DELIVERY_TOKEN=<random ≥16 chars>

# --- browser origins allowed (web app domain); "*" = any ---
CORS_ORIGINS=https://ketsuban-app.peeramid.xyz

# --- record term (seconds) ---
RECORD_TERM_SECONDS=2592000

# --- Node registrar fallback (spec B.9.7). Leave EMPTY when the CRE enclave signs. ---
REGISTRAR_KEY=
VIEWCODE_KEY=
