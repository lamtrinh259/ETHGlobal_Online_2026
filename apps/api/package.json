{
  "name": "@att/api",
  "version": "0.1.0",
  "private": true,
  "description": "Relay and verification API: submits enclave-signed records through the bridge, serves the machine-readable verification endpoint, and runs the Node registrar fallback",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@att/registrar": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@peeramid-labs/multipass-client": "1.1.0",
    "hono": "^4.7.11",
    "viem": "^2.38.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
