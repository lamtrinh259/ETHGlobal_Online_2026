{
  "name": "@ketsuban/web",
  "version": "0.1.0",
  "private": true,
  "description": "Ketsuban web: Privy sign-in, account linking, wallet-signed intent, publication and public verification pages",
  "scripts": {
    "dev": "node scripts/build-info.mjs && next dev",
    "build": "node scripts/build-info.mjs && next build",
    "start": "next start",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/build-info.mjs && tsc --noEmit",
    "lint": "prettier --check 'app/**/*.{ts,tsx}' 'lib/**/*.ts' 'test/**/*.{ts,tsx}' 'e2e/**/*.ts'",
    "lint:fix": "prettier --write 'app/**/*.{ts,tsx}' 'lib/**/*.ts' 'test/**/*.{ts,tsx}' 'e2e/**/*.ts'"
  },
  "dependencies": {
    "@ketsuban/contracts": "workspace:*",
    "@ketsuban/registrar": "workspace:*",
    "@noble/curves": "^1.9.2",
    "@peeramid-labs/multipass-client": "1.1.0",
    "@privy-io/react-auth": "^3.40.0",
    "@tanstack/react-query": "^5.62.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-icons": "^16.30.0",
    "viem": "^2.38.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
