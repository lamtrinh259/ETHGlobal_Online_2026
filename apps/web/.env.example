# Ketsuban web — build-time env. NEXT_PUBLIC_* values are INLINED into the client bundle at
# `next build` (not read at runtime), so set them in Coolify BEFORE the build and rebuild when they
# change. Copy to `.env.local` for local dev. Everything here is public by design — never a secret.

NEXT_PUBLIC_PRIVY_APP_ID=cmtr2o4p401xc0cjqur64l2m2
NEXT_PUBLIC_PRIVY_CLIENT_ID=client-WY6d7mKRG7hN32uoAWH5CZb3q8LUot5ChpVzVkHFiD2Gz

# The relay / verification API (apps/api). CORS must allow this site's origin.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# Where the signed request goes: the API's node fallback (/v1/attest) or a CRE HTTP trigger URL.
NEXT_PUBLIC_ATTEST_URL=http://127.0.0.1:8787/v1/attest

NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_MULTIPASS=0x418F82fd0014a4CA402F145978bfaF0555a9cA06
# Instance name domains the UI offers, and their ENS parent names, in the same order.
NEXT_PUBLIC_NAME_DOMAINS=ketsuban,kju-is
NEXT_PUBLIC_PARENT_NAMES=ketsuban.eth,kju-is.ketsuban.eth

# Canonical site URL for metadata (OpenGraph, manifest).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
